# DocChat AI - Environment Variables
# Copy this file to .env and fill in your actual API keys

# OpenAI API Key (required if not using OpenRouter)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-key-here

# OpenRouter API Key (required if not using OpenAI)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Firecrawl API Key (optional - only needed for web scraping)
# Get from: https://www.firecrawl.dev/
FIRECRAWL_API_KEY=fc-your-firecrawl-key-here

